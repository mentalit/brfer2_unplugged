<p style="color: green"><%= notice %></p>

<% content_for :title, "Aisles" %>

<h1>Aisles</h1>

<div id="aisles">
  <% @aisles.each do |aisle| %>
    <%= render aisle %>
    <p>
      <%= link_to "Show this aisle", aisle %>
    </p>
  <% end %>
</div>

<%= form_with url: import_store_aisles_path(@store), multipart: true do |f| %>
  <%= f.file_field :file, accept: ".csv,.txt" %>
  <%= f.submit "Import Warehouse Details" %>
<% end %>

<%= link_to "New aisle", new_store_aisle_path %>
