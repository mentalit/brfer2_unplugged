<div id="<%= dom_id aisle %>">
  <div>
    <strong>Aisle num:</strong>
    <%= aisle.aisle_num %>
  </div>

  <div>
    <strong>Aisle height:</strong>
    <%= aisle.aisle_height %>
  </div>

  <div>
    <strong>Maxlength:</strong>
    <%= aisle.MAXLENGTH %>
  </div>

  <div>
    <strong>Racktype:</strong>
    <%= aisle.RACKTYPE %>
  </div>

  <% if aisle.linked_aisle %>
    <div>
      <strong>Back-to-back with:</strong>
      <%= aisle.linked_aisle.aisle_num %>
    </div>
  <% end %>

  

  <% if action_name != 'index' %>
    <strong>Division:</strong>
    <%= aisle.DIVISION %>
  </div>

  <div>
    <strong>Maxwidth:</strong>
    <%= aisle.MAXWIDTH %>
  </div>


   <div>
    <strong>Loc:</strong>
    <%= aisle.LOC %>
  </div>

  <div>
    <strong>Type:</strong>
    <%= aisle.TYPE %>
  </div>

   <div>
    <strong>Checkstring:</strong>
    <%= aisle.CHECKSTRING %>
  </div>

  <div>
    <strong>Store:</strong>
    <%= aisle.store_id %>
  </div>

  <% end %>

  <div>
    <%= link_to "Sections", aisle_sections_path(aisle) %>
  </div>

</div>