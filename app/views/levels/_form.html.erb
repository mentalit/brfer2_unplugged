<%= form_with(model: [ @section, level] ) do |form| %>
  <% if level.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(level.errors.count, "error") %> prohibited this level from being saved:</h2>

      <ul>
        <% level.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :lev_num, style: "display: block" %>
    <%= form.text_field :lev_num %>
  </div>

  <div>
    <%= form.label :lev_depth, style: "display: block" %>
    <%= form.text_field :lev_depth %>
  </div>

  <div>
    <%= form.label :lev_height, style: "display: block" %>
    <%= form.text_field :lev_height %>
  </div>

  <div>
    <%= form.label :lev_width, style: "display: block" %>
    <%= form.text_field :lev_width %>
  </div>

  <div>
    <%= form.label :section_id, style: "display: block" %>
    <%= form.text_field :section_id %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
