<div id="<%= dom_id section %>">
  <div>
    <strong>Sec num:</strong>
    <%= section.Sec_num %>
  </div>

  <div>
    <strong>Sec width:</strong>
    <%= section.sec_width %>
  </div>

  <div>
    <strong>Sec length:</strong>
    <%= section.sec_length %>
  </div>

  <div>
    <strong>Sec depth:</strong>
    <%= section.sec_depth %>
  </div>

  <div>
    <strong>Sec height:</strong>
    <%= section.sec_height %>
  </div>

  <% if section.unlinked %>
    <div>
      <strong>Not linked:</strong>
      keeps its own depth
    </div>
  <% end %>

  <div>
    <strong>Aisle:</strong>
    <%= section.aisle_id %>
  </div>

</div>
