<p style="color: green"><%= notice %></p>
<p style="color: red"><%= alert %></p>

<% content_for :title, "Sections" %>

<%
  pallet_aisle    = PalletPlannerService.pallet_aisle?(@aisle)
  aisle_plannable = @aisle_plannable && !pallet_aisle
  filter_params   = { hfb: @hfb, pa: @pa, end_date: @end_date, start_date: @start_date, max_fcst: @max_fcst }
%>

<%# Every slid_h of an article, split and padded to 6 digits (10100 → 010100) %>
<% slids_for = ->(a) {
     Array(a["SLID"]).flat_map { |s| s.to_s.split(/[\s,;]+/) }
                     .reject(&:empty?)
                     .map { |s| s.match?(/\A\d{5}\z/) ? "0#{s}" : s }
   } %>

<h1>Sections — aisle <%= @aisle.aisle_num %></h1>

<% if @voss_aisle || pallet_aisle || aisle_plannable %>
  <div id="planner">
    <h2><%= @voss_aisle ? "Voss planner" : pallet_aisle ? "PALLET planner" : "Aisle planner" %></h2>

    <%= form_with url: aisle_sections_path(@aisle), method: :get do |f| %>
      <%= f.hidden_field :end_date,   value: @end_date %>
      <%= f.hidden_field :start_date, value: @start_date %>
      <%= f.hidden_field :max_fcst,   value: @max_fcst %>
      <%= f.hidden_field :ignore_weight, value: (@ignore_weight ? "1" : nil) %>

      <%= f.label :hfb, "HFB" %>
      <%= f.select :hfb, @hfbs,
                   { include_blank: (@voss_aisle || pallet_aisle ? "Select HFB" : "All HFBs"), selected: @hfb },
                   onchange: "this.form.requestSubmit()" %>

      <% if @hfb %>
        <%= f.label :pa, "PA" %>
        <%= f.select :pa, @pas, { include_blank: "All PAs", selected: @pa },
                     onchange: "this.form.requestSubmit()" %>
      <% end %>
    <% end %>

    <% if @voss_aisle && @hfb %>
      <%
        voss_defaults = {
          article_limit: 20000,
          max_height:    127,      # mm
          max_length:    1524,     # mm
          max_width:     1524,     # mm
          max_weight:    6803.89,  # g
          max_fcst:      4
        }
      %>
      <%= form_with url: plan_voss_aisle_sections_path(@aisle) do |f| %>
        <%= f.hidden_field :hfb, value: @hfb %>
        <%= f.hidden_field :pa,  value: @pa %>

        <div>
          <%= f.label :article_limit, "Article limit" %>
          <%= f.number_field :article_limit, value: voss_defaults[:article_limit], min: 1 %>
        </div>
        <div>
          <%= f.label :max_height, "Height (mm)" %>
          <%= f.number_field :max_height, value: voss_defaults[:max_height], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_length, "Length (mm)" %>
          <%= f.number_field :max_length, value: voss_defaults[:max_length], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_width, "Width (mm)" %>
          <%= f.number_field :max_width, value: voss_defaults[:max_width], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_weight, "Weight (g)" %>
          <%= f.number_field :max_weight, value: voss_defaults[:max_weight], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_fcst, "Max Fcst" %>
          <%= f.number_field :max_fcst, value: voss_defaults[:max_fcst], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :exclude_names, "Exclude article names (separate with commas)" %>
          <%= f.text_field :exclude_names, value: session[:voss_exclude_names], placeholder: "e.g. SKOGSTA, LACK" %>
        </div>
        <div>
          <%= f.check_box :dt_one_only %>
          <%= f.label :dt_one_only, "Only DT = 1 articles" %>
        </div>

        <%= f.submit @pa ? "Plan Voss (PA #{@pa})" : "Plan Voss (all of HFB #{@hfb})" %>
      <% end %>

      <p>
        <%= link_to "Export Voss CSV",
                    export_voss_aisle_sections_path(@aisle, hfb: @hfb, pa: @pa, format: :csv),
                    data: { turbo: false } %>
      </p>
    <% end %>

    <% if pallet_aisle && @hfb %>
      <%
        pallet_defaults = {
          article_limit: 50,
          max_height:    2286,  # mm
          max_length:    2286,  # mm
          max_width:     2286,  # mm
          max_weight:    2286,  # g
          max_fcst:      0.1,
          max_palq:      2
        }
      %>
      <%= form_with url: plan_pallet_aisle_sections_path(@aisle) do |f| %>
        <%= f.hidden_field :hfb, value: @hfb %>
        <%= f.hidden_field :pa,  value: @pa %>

        <div>
          <%= f.label :article_limit, "Article limit" %>
          <%= f.number_field :article_limit, value: pallet_defaults[:article_limit], min: 1 %>
        </div>
        <div>
          <%= f.label :max_height, "Height (mm)" %>
          <%= f.number_field :max_height, value: pallet_defaults[:max_height], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_length, "Length (mm)" %>
          <%= f.number_field :max_length, value: pallet_defaults[:max_length], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_width, "Width (mm)" %>
          <%= f.number_field :max_width, value: pallet_defaults[:max_width], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_weight, "Weight (g)" %>
          <%= f.number_field :max_weight, value: pallet_defaults[:max_weight], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_fcst, "Max Fcst" %>
          <%= f.number_field :max_fcst, value: pallet_defaults[:max_fcst], step: "any", min: 0 %>
        </div>
        <div>
          <%= f.label :max_palq, "PALQ (max)" %>
          <%= f.number_field :max_palq, value: pallet_defaults[:max_palq], step: "any", min: 0 %>
        </div>

        <%= f.submit @pa ? "Plan PALLET (PA #{@pa})" : "Plan PALLET (all of HFB #{@hfb})" %>
      <% end %>

      <p>
        <%= link_to "Export PALLET CSV",
                    export_pallet_aisle_sections_path(@aisle, hfb: @hfb, pa: @pa, format: :csv),
                    data: { turbo: false } %>
      </p>
    <% end %>

    <% if aisle_plannable %>
      <%= form_with url: plan_aisle_aisle_sections_path(@aisle) do |f| %>
        <%= f.hidden_field :hfb, value: @hfb %>
        <%= f.hidden_field :pa,  value: @pa %>

        <div>
          <%= f.label :end_date, "End Date Sale — plan blank or after" %>
          <%= f.date_field :end_date, value: @end_date %>
        </div>
        <div>
          <%= f.label :start_date, "Start Date Sale — plan blank or on/before" %>
          <%= f.date_field :start_date, value: @start_date %>
        </div>
        <div>
          <%= f.label :max_fcst, "Max Fcst" %>
          <%= f.number_field :max_fcst, value: @max_fcst, step: "any", min: 0 %>
        </div>
        <div>
          <%= f.check_box :ignore_weight, checked: @ignore_weight %>
          <%= f.label :ignore_weight, "No weight limit (heavy articles are not forced to level 00)" %>
        </div>

        <%= f.submit "Plan aisle #{@aisle.aisle_num}" +
                     (@pa ? " (PA #{@pa})" : @hfb ? " (HFB #{@hfb})" : "") %>
      <% end %>
    <% end %>
  </div>
<% end %>

<p>
  <%= link_to "Export all planned articles (CSV)",
              export_all_aisle_sections_path(@aisle, format: :csv),
              data: { turbo: false } %>
</p>

<div id="plan_upload">
  <h2>Plan CSV</h2>
  <%= form_with url: aisle_plan_upload_path(@aisle), multipart: true, data: { turbo: false } do |f| %>
    <%= f.file_field :plan_file, accept: ".csv,text/csv" %>
    <%= f.submit "Upload plan" %>
  <% end %>

  <p>
    <%= link_to "Export #{@voss_aisle ? 'Voss' : pallet_aisle ? 'PALLET' : "aisle #{@aisle.aisle_num}"} plan (CSV)",
                aisle_plan_export_path(@aisle, format: :csv),
                data: { turbo: false } %>
  </p>
</div>

<p>
  <%= button_to "Unplan aisle #{@aisle.aisle_num}",
                unplan_aisle_aisle_sections_path(@aisle),
                method: :delete,
                params: filter_params,
                form: { data: { turbo_confirm: "Remove every planned article from all sections in aisle #{@aisle.aisle_num}?" } } %>
</p>

<h2>Planned articles (<%= @placements.size %>)</h2>
<table>
  <thead>
    <tr>
      <th>Slid_h</th>
      <th>New slid</th>
      <th>ARTNO</th>
      <th>Name</th>
      <th>DT</th>
      <th>Qty</th>
      <th>Status</th>
      <th></th>
    </tr>
  </thead>

  <% @sections.each do |section| %>
    <% by_level     = @grouped[section.id] || {} %>
    <% levels       = section.levels.sort_by { |l| l.lev_num.to_i } %>
    <%# Back-to-back aisles: level 00 gets what the facing level 00 leaves, upper levels the aisle's own depth %>
    <% shared_depth = AislePlannerService.shared_ground_depth(section, @aisle) %>
    <% ground_depth = shared_depth || section.sec_depth.to_s.tr(",", ".").to_f %>
    <% upper_depth  = AislePlannerService.upper_depth(section, @aisle) %>
    <tbody>
      <tr style="background: #ddd;">
        <th colspan="8" style="text-align: left;">
          <%= link_to "Section #{format('%02d', section.Sec_num.to_i)}", section %>
          — width <%= section.sec_width %> mm,
                    depth <%= ground_depth.round %> mm<% if shared_depth %> (level 00, shared with aisle <%= @aisle.linked_aisle.aisle_num %>; upper levels <%= upper_depth.round %> mm)<% elsif @aisle.linked_aisle_id && section.unlinked %> (not linked)<% end %>,
          height <%= section.sec_height.presence || 2286 %> mm
          (<%= by_level.values.sum(&:size) %> <%= "article".pluralize(by_level.values.sum(&:size)) %>)
        </th>
      </tr>

      <% levels.each do |level| %>
        <% rows = by_level[level.id] || [] %>
        <tr style="background: #f2f2f2;">
          <td colspan="8" style="padding-left: 1.5em;">
            <strong>Level <%= level.lev_num %></strong>
            — depth <%= (level.lev_num.to_i == AislePlannerService::GROUND ? ground_depth : upper_depth).round %> mm
            <% if level.lev_height.to_f.positive? %>— height <%= level.lev_height %> mm<% end %>
            (<%= rows.size %> <%= "article".pluralize(rows.size) %>)
          </td>
        </tr>

        <% if rows.empty? %>
          <tr><td colspan="8" style="padding-left: 3em;"><em>Empty</em></td></tr>
        <% end %>

        <% rows.each do |p| %>
          <% a        = p.article %>
          <% slids    = slids_for.call(a) %>
          <% original = slids.include?(p.new_slid.to_s.strip) %>
          <tr>
            <td style="padding-left: 3em;"><%= slids.join(", ") %></td>
            <td><%= p.new_slid %></td>
            <td><%= link_to a["ARTNO"], article_path(a) %></td>
            <td><%= a["ARTNAME_UNICODE"] %></td>
            <td><%= a["DT"] %></td>
            <td><%= p.quantity %></td>
            <td><%= p.mode == AislePlannerService::MANUAL_MODE ? "Manual" : original ? "Original" : "Newly planned" %></td>
            <td>
              <%= button_to "Unassign",
                            unassign_article_aisle_sections_path(@aisle),
                            method: :delete,
                            params: filter_params.merge(article_id: a.id),
                            form: { data: { turbo_confirm: "Unassign #{a["ARTNO"]} from all its locations?" } } %>
            </td>
          </tr>
        <% end %>
      <% end %>

      <% if by_level[nil].present? %>
        <tr style="background: #f2f2f2;">
          <td colspan="8" style="padding-left: 1.5em;">
            <strong>No level</strong> (<%= by_level[nil].size %> <%= "article".pluralize(by_level[nil].size) %>)
          </td>
        </tr>
        <% by_level[nil].each do |p| %>
          <% a        = p.article %>
          <% slids    = slids_for.call(a) %>
          <% original = slids.include?(p.new_slid.to_s.strip) %>
          <tr>
            <td style="padding-left: 3em;"><%= slids.join(", ") %></td>
            <td><%= p.new_slid %></td>
            <td><%= link_to a["ARTNO"], article_path(a) %></td>
            <td><%= a["ARTNAME_UNICODE"] %></td>
            <td><%= a["DT"] %></td>
            <td><%= p.quantity %></td>
            <td><%= p.mode == AislePlannerService::MANUAL_MODE ? "Manual" : original ? "Original" : "Newly planned" %></td>
            <td>
              <%= button_to "Unassign",
                            unassign_article_aisle_sections_path(@aisle),
                            method: :delete,
                            params: filter_params.merge(article_id: a.id),
                            form: { data: { turbo_confirm: "Unassign #{a["ARTNO"]} from all its locations?" } } %>
            </td>
          </tr>
        <% end %>
      <% end %>
    </tbody>
  <% end %>
</table>

<%= link_to "New section", new_aisle_section_path(@aisle) %>