

<div class="row">
  
  <div class="col-4"><h1>Articles</h1></div>

  <div class="col-4"><%= link_to "New article", new_store_article_path %></div>


  <div class="col-4"><%= render "search_form" %></div>
</div>


<div class="row">
  <div class="col-6">
    <div class="card">
    <%= form_with url: import_store_articles_path(@store), multipart: true do |f| %>
  <div>
    <%= f.label :article_file, "Article CSV (slm0003 / Dash)" %>
    <%= f.file_field :article_file, accept: ".csv,.txt,.tsv" %>
  </div>
  <div>
    <%= f.label :item_file, "DWP CSV" %>
    <%= f.file_field :item_file, accept: ".csv,.txt,.tsv" %>
  </div>
  <div>
    <%= f.label :slm0002_file, "SLM0002 CSV (fills empty CP / UL measurements)" %>
    <%= f.file_field :slm0002_file, accept: ".csv,.txt,.tsv" %>
  </div>
  <div>
    <%= f.label :al010_file, "Al010 CSV (fills empty Start / End Date Sale)" %>
    <%= f.file_field :al010_file, accept: ".csv,.txt,.tsv" %>
  </div>
  <%= f.submit "Upload Articles" %>
<% end %>

</div>

</div>


  <div class="col-6">
    <div class="card">
    <%= form_with url: remove_store_articles_path(@store), multipart: true,
              data: { turbo_confirm: "Delete every article in this file and free its locations?" } do |f| %>
  <div>
    <%= f.label :remove_file, "Articles to delete (CSV with ARTNO)" %>
    <%= f.file_field :remove_file, accept: ".csv,.txt,.tsv" %>
  </div>
  <%= f.submit "Delete Articles" %>
<% end %>
  </div>
  </div>


</div>



<div class="container">
  <div class="row">

    <% @articles.each do |article| %>

      <div class="col-md-3 mb-3">
        <div class="card h-100">
          <div class="card-body">

            <%= render article %>

            <%= link_to "Show this article", article,
                class: "btn btn-primary mt-2" %>

          </div>
        </div>
      </div>

    <% end %>

  </div>
</div>