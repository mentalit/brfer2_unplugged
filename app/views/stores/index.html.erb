

<% content_for :title, "Stores" %>

<br>


<div class="row">

  <div class="col-6"><h1>Stores</h1></div>  


  <div class="col-6"><%= link_to "New store", new_store_path %></div>



</div>

<div class="row">

  
  <% @stores.each do |store| %>
  <div class="card col-2">
    <%= render store %>
    <p>
      <%= link_to "Show this store", store %>
    </p>
 </div>
  <% end %>

 
</div>


  



